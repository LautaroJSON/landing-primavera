---
import type { PuntoDeAcceso } from "../types/content-schema";

interface Props {
  punto: PuntoDeAcceso;
}

const { punto } = Astro.props;
---

<section id="como-llegar" class="bg-papel-alt px-4 py-20 sm:px-6">
  <div class="mx-auto grid max-w-5xl gap-8 md:grid-cols-2 md:items-center">
    <div
      class="relative aspect-4/3 overflow-hidden border-2 border-tinta bg-papel"
      id="mapa-como-llegar"
      data-lat={punto.lat}
      data-lng={punto.lng}
      data-lugar={punto.direccionReferencia}
      aria-label={`Referencia de ubicación: ${punto.direccionReferencia}`}
    >
      <!-- FR-019/FR-021: contenido estático que se ve mientras el mapa no
           entró en viewport, y que queda como fallback si el mapa interactivo
           no llega a cargar (falla de red/JS deshabilitado). -->
      <div
        class="absolute inset-0 flex items-center justify-center"
        data-mapa-fallback
      >
        <div class="text-center">
          <span class="text-5xl" aria-hidden="true">📍</span>
          <p
            class="mt-2 font-display text-lg font-semibold text-follaje-oscuro"
          >
            {punto.direccionReferencia}
          </p>
        </div>
      </div>

      <!-- Marco decorativo: queda por encima del mapa una vez montado, así
           el mapa real conserva la estética de "recuadro de programa". -->
      <span
        class="pointer-events-none absolute top-3 left-3 z-10 h-3 w-3 border-2 border-tinta"
        aria-hidden="true"></span>
      <span
        class="pointer-events-none absolute top-3 right-3 z-10 h-3 w-3 border-2 border-tinta"
        aria-hidden="true"></span>
      <span
        class="pointer-events-none absolute bottom-3 left-3 z-10 h-3 w-3 border-2 border-tinta"
        aria-hidden="true"></span>
      <span
        class="pointer-events-none absolute right-3 bottom-3 z-10 h-3 w-3 border-2 border-tinta"
        aria-hidden="true"></span>
    </div>

    <div>
      <p class="rotulo text-sm font-bold text-follaje-oscuro">Ubicación</p>
      <h2 class="mt-1 text-3xl font-semibold text-tinta sm:text-4xl">
        Cómo llegar
      </h2>
      <p class="mt-2 text-tinta/75">
        El festival es en <strong>{punto.direccionReferencia}</strong>, a cielo
        abierto y de fácil acceso en transporte público.
      </p>

      <ul class="mt-5 space-y-2">
        {
          punto.mediosDeAcceso.map((medio) => (
            <li class="flex items-start gap-3 text-sm text-tinta">
              <span
                class="mt-0.5 h-2.5 w-2.5 shrink-0 bg-celeste-oscuro"
                aria-hidden="true"
              />
              {medio}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
  // FR-019/FR-020: mapa interactivo (Leaflet + tiles CartoDB Positron sobre
  // OpenStreetMap), cargado solo cuando la sección entra en viewport — el
  // import dinámico hace que Vite separe Leaflet (JS + CSS) en un chunk que
  // nunca se descarga si el visitante no llega a "Cómo llegar" (no afecta el
  // LCP del hero). FR-021: si el import falla (sin red/JS deshabilitado), el
  // contenido estático de [data-mapa-fallback] queda visible sin cambios.
  const contenedor = document.getElementById("mapa-como-llegar");

  if (contenedor) {
    const lat = Number(contenedor.dataset.lat);
    const lng = Number(contenedor.dataset.lng);
    const lugar = contenedor.dataset.lugar ?? "";

    const observer = new IntersectionObserver(
      (entradas) => {
        const [entrada] = entradas;
        if (!entrada?.isIntersecting) return;
        observer.disconnect();
        montarMapa(contenedor, lat, lng, lugar).catch(() => {
          // Fallback estático (FR-021): no se toca el DOM si falla la carga.
        });
      },
      { rootMargin: "200px" },
    );

    observer.observe(contenedor);
  }

  async function montarMapa(
    contenedor: HTMLElement,
    lat: number,
    lng: number,
    lugar: string,
  ) {
    // "?url" evita que Vite inyecte un <link rel="stylesheet"> eager en el
    // <head> del build (lo haría incluso con import() dinámico, porque el
    // specifier es un string estático) — así el CSS de Leaflet solo se
    // adjunta al DOM en el momento en que este observer dispara (FR-020).
    const [L, { default: hojaDeEstilosUrl }] = await Promise.all([
      import("leaflet"),
      import("leaflet/dist/leaflet.css?url"),
    ]);

    if (!document.querySelector(`link[href="${hojaDeEstilosUrl}"]`)) {
      const link = document.createElement("link");
      link.rel = "stylesheet";
      link.href = hojaDeEstilosUrl;
      document.head.appendChild(link);
    }

    const capaMapa = document.createElement("div");
    capaMapa.className = "absolute inset-0";
    contenedor.appendChild(capaMapa);

    const mapa = L.map(capaMapa, {
      center: [lat, lng],
      zoom: 16,
      scrollWheelZoom: false,
    });

    L.tileLayer(
      "https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png",
      {
        subdomains: "abcd",
        maxZoom: 20,
        detectRetina: true,
        attribution:
          '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions" target="_blank" rel="noopener">CARTO</a>',
      },
    ).addTo(mapa);

    const icono = L.divIcon({
      className: "mapa-marcador-personalizado",
      html: `<svg viewBox="0 0 40 52" width="40" height="52" aria-hidden="true">
        <path d="M20 0C9 0 0 8.7 0 19.4 0 33 20 52 20 52S40 33 40 19.4C40 8.7 31 0 20 0Z" fill="var(--color-follaje-oscuro)" />
        <circle cx="20" cy="19" r="7" fill="var(--color-papel)" />
      </svg>`,
      iconSize: [40, 52],
      iconAnchor: [20, 50],
      popupAnchor: [0, -46],
    });

    L.marker([lat, lng], { icon: icono, title: lugar })
      .addTo(mapa)
      .bindPopup(`<strong>${lugar}</strong>`)
      .openPopup();

    contenedor.setAttribute("aria-label", `Mapa interactivo: ${lugar}`);
    contenedor.querySelector("[data-mapa-fallback]")?.remove();
  }
</script>
