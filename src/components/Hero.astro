---
import { Image } from "astro:assets";
import type { Evento } from "../types/content-schema";
import { heroBackgrounds } from "../data/heroBackgrounds";
import CtaRegistro from "./CtaRegistro.astro";

interface Props {
  evento: Evento;
}

const { evento } = Astro.props;

const fechaLegible = new Intl.DateTimeFormat("es-AR", {
  day: "numeric",
  month: "long",
}).format(new Date(`${evento.fecha}T12:00:00`));

// Firma visual: sol radiante (motivo de "primavera" + agenda de festival),
// generado como rayos triangulares en vez de un ícono/emoji suelto.
const RAYOS = 16;
const rayos = Array.from({ length: RAYOS }, (_, i) => (360 / RAYOS) * i);
---

<section
  id="hero"
  class="relative flex min-h-[100svh] items-end overflow-hidden text-papel"
>
  <!-- Capa de fondo: rota entre imágenes con crossfade (FR-017) y se mueve con
       parallax como una sola capa (FR-008), sin que ambos comportamientos se
       interrumpan entre sí (FR-018). -->
  <div
    class="absolute inset-0 h-[120%] w-full"
    data-parallax-speed="0.3"
    data-hero-bg-rotator
  >
    {
      heroBackgrounds.map((imagen, index) => (
        <Image
          src={imagen.src}
          alt={imagen.alt}
          data-hero-bg-layer
          class="absolute inset-0 h-full w-full object-cover"
          style={`opacity: ${index === 0 ? 1 : 0}`}
          widths={[480, 800, 1280, 1920]}
          sizes="100vw"
        />
      ))
    }
    <div
      class="absolute inset-0 bg-gradient-to-t from-tinta/85 via-tinta/45 to-tinta/15"
      aria-hidden="true"
    >
    </div>
  </div>

  <!-- Capa de frente: el sol radiante se mueve a otra velocidad de scroll que
       el fondo, dando profundidad al parallax (FR-008). Es la firma visual
       del sitio: primavera + agenda de festival, no decoración genérica. -->
  <div
    class="pointer-events-none absolute inset-0"
    data-parallax-speed="-0.15"
    aria-hidden="true"
  >
    <svg
      viewBox="-100 -100 200 200"
      class="absolute -right-24 -bottom-32 h-[34rem] w-[34rem] text-sol opacity-90 sm:-right-16 sm:-bottom-40 sm:h-[42rem] sm:w-[42rem]"
    >
      <circle r="34" fill="currentColor"></circle>
      {
        rayos.map((deg) => (
          <rect
            x="-2.5"
            y="-96"
            width="5"
            height="34"
            fill="currentColor"
            transform={`rotate(${deg})`}
          />
        ))
      }
    </svg>
  </div>

  <div class="relative z-10 w-full px-4 pb-14 sm:px-6">
    <div class="mx-auto max-w-3xl">
      <p
        class="rotulo mb-4 inline-block -rotate-2 border-2 border-papel bg-tinta/40 px-3 py-1 text-xs font-bold text-papel backdrop-blur-sm"
      >
        Proyecto ficticio de portfolio
      </p>
      <h1
        class="text-4xl leading-[1.05] font-semibold text-papel sm:text-5xl md:text-6xl"
      >
        {evento.nombre}
      </h1>
      <p class="mt-4 max-w-xl text-base text-papel/85 sm:text-lg">
        {evento.descripcionCorta}
      </p>

      <dl class="mt-6 flex flex-wrap gap-3">
        <div
          class="flex flex-col border-2 border-papel/70 bg-tinta/30 px-4 py-2 backdrop-blur-sm"
        >
          <dt class="rotulo text-[0.65rem] text-sol">Fecha</dt>
          <dd class="font-display text-lg font-semibold text-papel">
            {fechaLegible}
          </dd>
        </div>
        <div
          class="flex flex-col border-2 border-papel/70 bg-tinta/30 px-4 py-2 backdrop-blur-sm"
        >
          <dt class="rotulo text-[0.65rem] text-sol">Lugar</dt>
          <dd class="font-display text-lg font-semibold text-papel">
            {evento.lugar}
          </dd>
        </div>
      </dl>

      <div class="mt-8">
        <CtaRegistro variante="hero" />
      </div>
    </div>
  </div>
</section>
