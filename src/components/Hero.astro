---
import { Image } from "astro:assets";
import type { Evento } from "../types/content-schema";
import { heroBackgrounds } from "../data/heroBackgrounds";
import CtaRegistro from "./CtaRegistro.astro";

interface Props {
  evento: Evento;
}

const { evento } = Astro.props;

const fechaLegible = new Intl.DateTimeFormat("es-AR", {
  day: "numeric",
  month: "long",
}).format(new Date(`${evento.fecha}T12:00:00`));
---

<section
  id="hero"
  class="relative flex min-h-[100svh] items-end overflow-hidden text-fondo-blanco"
>
  <!-- Capa de fondo: rota entre imágenes con crossfade (FR-017) y se mueve con
       parallax como una sola capa (FR-008), sin que ambos comportamientos se
       interrumpan entre sí (FR-018). -->
  <div
    class="absolute inset-0 h-[120%] w-full"
    data-parallax-speed="0.3"
    data-hero-bg-rotator
  >
    {
      heroBackgrounds.map((imagen, index) => (
        <Image
          src={imagen.src}
          alt={imagen.alt}
          data-hero-bg-layer
          class="absolute inset-0 h-full w-full object-cover"
          style={`opacity: ${index === 0 ? 1 : 0}`}
          widths={[480, 800, 1280, 1920]}
          sizes="100vw"
        />
      ))
    }
    <div
      class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/35 to-black/10"
      aria-hidden="true"
    >
    </div>
  </div>

  <!-- Capa de frente: formas decorativas que se mueven a otra velocidad de
       scroll, dando profundidad al parallax (FR-008). -->
  <div
    class="pointer-events-none absolute inset-0"
    data-parallax-speed="-0.15"
    aria-hidden="true"
  >
    <div
      class="absolute -top-10 -left-10 h-56 w-56 rounded-full bg-amarillo/30 blur-2xl"
    >
    </div>
    <div
      class="absolute top-1/3 -right-16 h-72 w-72 rounded-full bg-rosa-violeta/30 blur-2xl"
    >
    </div>
    <div
      class="absolute bottom-10 left-1/4 h-40 w-40 rounded-full bg-celeste-acento/25 blur-2xl"
    >
    </div>
  </div>

  <div class="relative z-10 w-full px-4 pb-14 sm:px-6">
    <div class="mx-auto max-w-3xl">
      <p
        class="mb-3 inline-flex items-center gap-2 rounded-full bg-fondo-blanco/15 px-4 py-1.5 text-sm font-medium backdrop-blur"
      >
        <span class="inline-block h-2 w-2 rounded-full bg-amarillo"></span>
        Proyecto ficticio de portfolio
      </p>
      <h1 class="text-4xl leading-tight font-extrabold sm:text-5xl md:text-6xl">
        {evento.nombre}
      </h1>
      <p class="mt-4 max-w-xl text-base text-fondo-blanco/90 sm:text-lg">
        {evento.descripcionCorta}
      </p>

      <dl class="mt-6 flex flex-wrap gap-3">
        <div
          class="flex items-center gap-2 rounded-xl bg-fondo-blanco/15 px-4 py-2 backdrop-blur"
        >
          <dt class="sr-only">Fecha</dt>
          <dd class="text-sm font-semibold sm:text-base">
            📅 {fechaLegible}
          </dd>
        </div>
        <div
          class="flex items-center gap-2 rounded-xl bg-fondo-blanco/15 px-4 py-2 backdrop-blur"
        >
          <dt class="sr-only">Lugar</dt>
          <dd class="text-sm font-semibold sm:text-base">📍 {evento.lugar}</dd>
        </div>
      </dl>

      <div class="mt-8">
        <CtaRegistro variante="hero" />
      </div>
    </div>
  </div>
</section>
