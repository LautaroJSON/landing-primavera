---
import type { Actividad, CronogramaItem } from "../types/content-schema";

interface Props {
  items: CronogramaItem[];
  actividades: Actividad[];
}

const { items, actividades } = Astro.props;

const itemsOrdenados = [...items].sort((a, b) => a.hora.localeCompare(b.hora));
const actividadPorId = new Map(actividades.map((a) => [a.id, a]));
---

<section id="cronograma" class="bg-fondo-blanco px-4 py-16 sm:px-6">
  <div class="mx-auto max-w-3xl">
    <h2 class="text-3xl font-bold text-verde-oscuro sm:text-4xl">Cronograma</h2>
    <p class="mt-2 text-texto-principal/80">Así queda armado el día:</p>

    <ol class="relative mt-8 border-l-2 border-verde-primario/30 pl-6">
      {
        itemsOrdenados.map((item) => {
          const actividad = actividadPorId.get(item.actividadId);
          return (
            <li class="relative mb-8 last:mb-0">
              <span class="absolute top-1 -left-[1.95rem] h-3 w-3 rounded-full bg-verde-primario" />
              <p class="text-sm font-bold text-verde-oscuro">{item.hora} h</p>
              <p class="font-semibold text-texto-principal">
                {actividad?.titulo}
              </p>
              {item.notaHorario && (
                <p class="text-sm text-texto-principal/70">
                  {item.notaHorario}
                </p>
              )}
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
