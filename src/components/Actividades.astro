---
import type { Actividad } from "../types/content-schema";

interface Props {
  actividades: Actividad[];
}

const { actividades } = Astro.props;

// Ícono decorativo por actividad (aria-hidden — el contenido significativo es
// el texto de título/descripción, no depende del emoji para entenderse).
const iconos: Record<string, string> = {
  "apertura-bienvenida": "🌼",
  "feria-talleres": "🎨",
  "food-trucks": "🌮",
  "murga-batucada": "🥁",
  "recital-bandas": "🎸",
  "cierre-dj-sorteos": "🎉",
};

// Rotación de acento por tarjeta (no jerárquica: solo variedad visual entre
// tarjetas de un mismo tipo de contenido).
const acentos = ["bg-sol", "bg-flor", "bg-follaje", "bg-celeste"];
---

<section id="actividades" class="bg-papel-alt px-4 py-20 sm:px-6">
  <div class="mx-auto max-w-5xl">
    <p class="rotulo text-sm font-bold text-follaje-oscuro">El programa</p>
    <h2 class="mt-1 text-3xl font-semibold text-tinta sm:text-4xl">
      Actividades
    </h2>
    <p class="mt-2 max-w-2xl text-tinta/75">
      Un poco de todo para pasar el día: arte, música, comida y actividades al
      aire libre.
    </p>

    <ul class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        actividades.map((actividad, index) => (
          <li class="border-2 border-tinta/15 bg-papel p-5">
            <span
              class:list={[
                "inline-flex h-11 w-11 items-center justify-center border-2 border-tinta text-xl",
                acentos[index % acentos.length],
              ]}
              aria-hidden="true"
            >
              {iconos[actividad.id] ?? "✨"}
            </span>
            <h3 class="mt-4 font-display text-lg font-semibold text-tinta">
              {actividad.titulo}
            </h3>
            <p class="mt-1 text-sm text-tinta/70">{actividad.descripcion}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
