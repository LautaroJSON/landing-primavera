---
import type { Actividad } from "../types/content-schema";

interface Props {
  actividades: Actividad[];
}

const { actividades } = Astro.props;

// Ícono decorativo por actividad (aria-hidden — el contenido significativo es
// el texto de título/descripción, no depende del emoji para entenderse).
const iconos: Record<string, string> = {
  "apertura-bienvenida": "🌼",
  "feria-talleres": "🎨",
  "food-trucks": "🌮",
  "murga-batucada": "🥁",
  "recital-bandas": "🎸",
  "cierre-dj-sorteos": "🎉",
};
---

<section id="actividades" class="bg-fondo-offwhite px-4 py-16 sm:px-6">
  <div class="mx-auto max-w-5xl">
    <h2 class="text-3xl font-bold text-verde-oscuro sm:text-4xl">
      Actividades
    </h2>
    <p class="mt-2 max-w-2xl text-texto-principal/80">
      Un poco de todo para pasar el día: arte, música, comida y actividades al
      aire libre.
    </p>

    <ul class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        actividades.map((actividad) => (
          <li class="rounded-2xl bg-fondo-blanco p-5 shadow-sm ring-1 ring-black/5">
            <span class="text-3xl" aria-hidden="true">
              {iconos[actividad.id] ?? "✨"}
            </span>
            <h3 class="mt-3 text-lg font-semibold text-texto-principal">
              {actividad.titulo}
            </h3>
            <p class="mt-1 text-sm text-texto-principal/75">
              {actividad.descripcion}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
